# Database configuration
DATABASE_URL=postgresql+asyncpg://kensara:password@localhost:5432/bhulekh

# Application configuration
APP_ENV=development
SECRET_KEY=supersecretkey-change-me-in-production

# Authentication
# Comma-separated list of allowed emails for magic link authentication
ALLOWED_EMAILS=admin@example.com,user@example.com

# Frontend URL(s), comma-separated. The magic link uses whichever one the request came from.
# e.g. FRONTEND_URL=http://localhost:5173,https://your-name.ngrok-free.app
FRONTEND_URL=http://localhost:5173
